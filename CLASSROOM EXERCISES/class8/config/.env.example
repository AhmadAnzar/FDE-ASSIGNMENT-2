# FlashEats Pipeline Environment Configuration
# Copy this file to .env to override defaults in your local environment.

# Dispatch API
DISPATCH_API_URL=http://127.0.0.1:8000/dispatch/orders
DISPATCH_HEALTH_URL=http://127.0.0.1:8000/health
AUTO_START_MOCK_API=true
API_PAGE_SIZE=50

# Retry & Resilience Settings
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0

# Quality & Freshness Thresholds
MAX_DATA_AGE_DAYS=60
LATE_DELAY_THRESHOLD_MIN=0.0
